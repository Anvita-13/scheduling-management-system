# Copy to `.env` in this same folder (next to docker-compose.yml) and adjust as needed:
#     cp .env.example .env            (Windows PowerShell: copy .env.example .env)
# NEVER commit the real .env file (it is already covered by .gitignore).
#
# Nothing here is required to get started — `docker compose up --build` works with the defaults baked
# into docker-compose.yml — but set a real SECRET_KEY and POSTGRES_PASSWORD before leaving this running
# anywhere other than your own machine.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheduling
POSTGRES_PORT=5432            # host port for direct DB access (DBeaver/psql); change if 5432 is taken

# --- Backend (FastAPI) ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_CLASS_CAPACITY=30
DEFAULT_MIN_CREDITS=12
DEFAULT_MAX_CREDITS=24
BCRYPT_ROUNDS=12
BACKEND_PORT=8000              # host port for the API directly (e.g. /docs); optional

# --- Sample data (loaded automatically by the backend container on first start) ---
SEED_ON_START=true             # safe to leave on: it skips itself once the database already has data
RESET_ON_START=false            # true = wipe the database and reload fresh sample data on EVERY start
SEED_ADMIN_PASSWORD=            # empty = the documented demo password (Admin@123). SET THIS if anyone else can reach the app.
                                # Only applies when the sample data is first created (or on RESET_ON_START).

# --- Frontend ---
FRONTEND_PORT=3000              # the port you open in your browser
